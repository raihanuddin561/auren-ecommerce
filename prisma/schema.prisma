// AUREN physical data model. Logical model and rationale: docs/architecture/DATA-MODEL.md
//
// Conventions (see the auren-db-change skill):
//  - ids are UUIDv7 (time ordered), generated by Prisma: `@default(uuid(7)) @db.Uuid`
//  - tables are plural snake_case via @@map, columns snake_case via @map
//  - timestamps are timestamptz: created_at / updated_at
//  - money is BigInt minor units with a sibling `currency` column, never Decimal or Float
//  - ledger tables (outbox_events, audit_logs, stock_movements, ...) are append-only

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Key/value store settings (store info, currency, tax, policies, feature flags).
model StoreSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

/// Guards submits (checkout, payment) so a retried request returns the first response.
model IdempotencyKey {
  key         String   @id
  scope       String
  requestHash String?  @map("request_hash")
  response    Json?
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------------------------
// Identity (Better Auth). Model and field names follow what Better Auth's Prisma adapter expects;
// tables and columns are mapped to the AUREN snake_case convention.
// ---------------------------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid(7)) @db.Uuid
  name               String
  email              String   @unique @db.Citext
  emailVerified      Boolean  @default(false) @map("email_verified")
  image              String?
  phone              String?  @unique
  phoneVerified      Boolean  @default(false) @map("phone_verified")
  banned             Boolean  @default(false)
  /// Source of truth for staff two-factor enforcement (managed by the Better Auth plugin).
  twoFactorEnabled   Boolean  @default(false) @map("two_factor_enabled")
  /// Bootstrap password in use (first owner): staff must choose their own before anything else.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]
  staffMember StaffMember?

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// Password hash (scrypt) for credential accounts.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// ---------------------------------------------------------------------------------------------
// Staff access control (ARCHITECTURE section 11)
// ---------------------------------------------------------------------------------------------

enum StaffRole {
  owner
  admin
  manager
  order_verifier
  fulfillment
  finance
  content_editor
  support

  @@map("staff_role")
}

model StaffMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  role      StaffRole
  active    Boolean   @default(true)
  invitedBy String?   @map("invited_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([role])
  @@map("staff_members")
}

/// Which permissions each role holds. Seeded by migration; the application role can only read it (ADR-021).
model RolePermission {
  role       StaffRole
  permission String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([role, permission])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------------------------
// Transactional outbox and consumer inbox (ARCHITECTURE section 3.2, ADR-006)
// ---------------------------------------------------------------------------------------------

enum OutboxStatus {
  pending
  dispatched
  failed

  @@map("outbox_status")
}

/// Domain events written in the same transaction as the state change. Append-only: the
/// dispatcher may only touch status, attempts, availability, lease and error columns.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  /// Not dispatched before this time (retry backoff).
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  /// Lease held by a dispatcher while it sends the event.
  lockedUntil   DateTime?    @map("locked_until") @db.Timestamptz(6)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt  DateTime?    @map("dispatched_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

/// Which consumer already handled which event, so re-delivery has no second effect (INV-E2).
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

// ---------------------------------------------------------------------------------------------
// Audit trail: who changed what in the admin (append-only)
// ---------------------------------------------------------------------------------------------

/// Deliberately without a foreign key to users: the trail must outlive any account change.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// Catalog and stock foundations used by the development seed. Catalog and inventory modules extend
// these tables (collections, size charts, search vectors, reservations, ...).
// ---------------------------------------------------------------------------------------------

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

enum ProductFit {
  slim
  regular
  relaxed

  @@map("product_fit")
}

enum MediaType {
  image
  video

  @@map("media_type")
}

enum LocationType {
  warehouse
  store

  @@map("location_type")
}

enum StockMovementType {
  receipt
  sale
  reservation
  release
  return_restock
  adjustment
  transfer_in
  transfer_out
  write_off

  @@map("stock_movement_type")
}

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  slug           String
  name           String
  description    String?
  image          String?
  /// Required when an image is set (content standard).
  imageAlt       String?  @map("image_alt")
  position       Int      @default(0)
  /// Materialised path such as tops/shirts; unique across the tree.
  path           String   @unique
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  slug             String        @unique
  title            String
  subtitle         String?
  /// Markdown.
  description      String?
  status           ProductStatus @default(draft)
  categoryId       String?       @map("category_id") @db.Uuid
  productType      String?       @map("product_type")
  material         String?
  careInstructions String?       @map("care_instructions")
  fit              ProductFit?
  origin           String?
  sizeChartId      String?       @map("size_chart_id") @db.Uuid
  tags             String[]      @default([])
  /// Fabric, occasion, season, pattern.
  attributes       Json          @default("{}")
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description")
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  featuredRank     Int?          @map("featured_rank")
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sizeChart   SizeChart?          @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  options     ProductOption[]
  variants    ProductVariant[]
  media       ProductMedia[]
  collections CollectionProduct[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@index([sizeChartId])
  @@map("products")
}

model ProductOption {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  /// Size, Color, Fit...
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id          String  @id @default(uuid(7)) @db.Uuid
  optionId    String  @map("option_id") @db.Uuid
  value       String
  label       String
  swatchHex   String? @map("swatch_hex")
  swatchImage String? @map("swatch_image")
  position    Int     @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]
  media    ProductMedia[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id             String        @id @default(uuid(7)) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  sku            String        @unique
  barcode        String?
  priceMinor     BigInt        @map("price_minor")
  compareAtMinor BigInt?       @map("compare_at_minor")
  /// Weighted average landed cost; snapshotted onto order lines.
  avgCostMinor   BigInt        @default(0) @map("avg_cost_minor")
  currency       String        @default("BDT") @db.Char(3)
  weightG        Int?          @map("weight_g")
  status         ProductStatus @default(active)
  position       Int           @default(0)
  isDefault      Boolean       @default(false) @map("is_default")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  inventory    InventoryLevel[]
  movements    StockMovement[]
  reservations StockReservation[]
  poItems      PurchaseOrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model ProductMedia {
  id            String    @id @default(uuid(7)) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  /// Ties an image to one colour.
  optionValueId String?   @map("option_value_id") @db.Uuid
  type          MediaType @default(image)
  /// static (file shipped with the app, development placeholders), local (development uploads) or vercel-blob.
  provider      String    @default("static")
  /// Random storage key from lib/media; null only for static files.
  storageKey    String?   @map("storage_key")
  url           String
  /// jpeg, png, webp or avif only (CHECK); never SVG.
  contentType   String?   @map("content_type")
  sizeBytes     Int?      @map("size_bytes")
  /// Required: descriptive alt text is part of the content standard.
  alt           String
  width         Int?
  height        Int?
  dominantColor String?   @map("dominant_color")
  blurData      String?   @map("blur_data")
  position      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_media")
}

/// Measurement table shared by many products. `table` is { columns: string[], rows: [{ size, values: string[] }] }.
model SizeChart {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  /// cm or in (CHECK).
  unit         String   @default("cm")
  table        Json     @default("{}")
  /// Markdown.
  howToMeasure String?  @map("how_to_measure")
  modelInfo    String?  @map("model_info")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("size_charts")
}

model Collection {
  id             String    @id @default(uuid(7)) @db.Uuid
  slug           String    @unique
  title          String
  description    String?
  /// { url, alt, provider, storageKey, contentType, sizeBytes } from the MediaProvider; alt is required.
  heroMedia      Json?     @map("hero_media")
  /// manual or automatic (CHECK).
  type           String    @default("manual")
  /// Automatic collections: { match: all|any, conditions: [{ field, operator, value }] }.
  rules          Json      @default("{}")
  /// manual, best_selling, newest, price_asc, price_desc (CHECK).
  sortOrder      String    @default("manual") @map("sort_order")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  /// Null = draft. A future date schedules the publication.
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  isFeatured     Boolean   @default(false) @map("is_featured")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  products CollectionProduct[]

  @@index([publishedAt])
  @@map("collections")
}

/// Manual members, or the materialised result of an automatic collection's rules.
model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
  @@map("collection_products")
}

/// Created automatically when the slug of a published product, category or collection changes.
model Redirect {
  id         String   @id @default(uuid(7)) @db.Uuid
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  /// 301 or 302 (CHECK).
  statusCode Int      @default(301) @map("status_code")
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([toPath])
  @@map("redirects")
}

model Location {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  type      LocationType @default(warehouse)
  address   Json?
  isDefault Boolean      @default(false) @map("is_default")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventory    InventoryLevel[]
  movements    StockMovement[]
  reservations StockReservation[]
  receipts     GoodsReceipt[]

  @@map("locations")
}

/// available = on_hand - reserved. Only the inventory service writes here once it exists.
model InventoryLevel {
  variantId         String   @map("variant_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([variantId, locationId])
  @@index([locationId])
  @@map("inventory_levels")
}

/// Append-only ledger of every stock change; the sum per variant and location equals on_hand.
model StockMovement {
  id            String            @id @default(uuid(7)) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  type          StockMovementType
  /// Signed: receipts are positive, sales negative.
  quantity      Int
  unitCostMinor BigInt?           @map("unit_cost_minor")
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  reason        String?
  actorId       String?           @map("actor_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt(sort: Desc)])
  @@index([locationId])
  @@map("stock_movements")
}

enum ReservationStatus {
  active
  committed
  released

  @@map("reservation_status")
}

/// Stock held for a checkout or order until it is committed or released (or expires: active only).
model StockReservation {
  id            String            @id @default(uuid(7)) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  /// Always > 0 (CHECK).
  quantity      Int
  /// checkout, order ... together with referenceId it makes reserve idempotent per variant.
  referenceType String            @map("reference_type")
  referenceId   String            @map("reference_id")
  status        ReservationStatus @default(active)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([referenceType, referenceId, variantId])
  @@index([variantId])
  @@index([locationId])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------------------------

enum PurchaseOrderStatus {
  draft
  ordered
  partially_received
  received
  cancelled

  @@map("purchase_order_status")
}

enum LandedCostType {
  freight
  customs_duty
  inbound_transport
  agent_fee
  other

  @@map("landed_cost_type")
}

enum AllocationMethod {
  by_quantity
  by_value

  @@map("allocation_method")
}

model Supplier {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  contactName  String?  @map("contact_name")
  phone        String?
  email        String?
  address      String?
  paymentTerms String?  @map("payment_terms")
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(uuid(7)) @db.Uuid
  /// PO-0001 style, from a database sequence.
  poNumber   String              @unique @default(dbgenerated("('PO-'::text || lpad((nextval('purchase_order_number_seq'::regclass))::text, 4, '0'::text))")) @map("po_number")
  supplierId String              @map("supplier_id") @db.Uuid
  status     PurchaseOrderStatus @default(draft)
  currency   String              @default("BDT") @db.Char(3)
  orderedAt  DateTime?           @map("ordered_at") @db.Timestamptz(6)
  expectedAt DateTime?           @map("expected_at") @db.Timestamptz(6)
  notes      String?
  createdBy  String?             @map("created_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  landedCosts LandedCost[]
  receipts    GoodsReceipt[]

  @@index([supplierId])
  @@index([status, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String @id @default(uuid(7)) @db.Uuid
  poId             String @map("po_id") @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  quantityOrdered  Int    @map("quantity_ordered")
  quantityReceived Int    @default(0) @map("quantity_received")
  unitCostMinor    BigInt @map("unit_cost_minor")

  purchaseOrder PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]

  @@unique([poId, variantId])
  @@index([variantId])
  @@map("purchase_order_items")
}

model LandedCost {
  id               String           @id @default(uuid(7)) @db.Uuid
  poId             String           @map("po_id") @db.Uuid
  type             LandedCostType
  amountMinor      BigInt           @map("amount_minor")
  allocationMethod AllocationMethod @default(by_quantity) @map("allocation_method")
  note             String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@map("landed_costs")
}

/// One delivery against a purchase order. Append-only together with its lines.
model GoodsReceipt {
  id         String   @id @default(uuid(7)) @db.Uuid
  poId       String   @map("po_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  receivedBy String?  @map("received_by") @db.Uuid
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Restrict)
  location      Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([poId])
  @@index([locationId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String @id @default(uuid(7)) @db.Uuid
  receiptId       String @map("receipt_id") @db.Uuid
  poItemId        String @map("po_item_id") @db.Uuid
  quantity        Int
  /// Supplier unit price at receipt.
  unitCostMinor   BigInt @map("unit_cost_minor")
  /// Landed costs allocated to this delivery (total for the line, not per unit).
  landedCostMinor BigInt @default(0) @map("landed_cost_minor")

  receipt GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  poItem  PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([poItemId])
  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------------------------------
// Insider-risk controls: maker-checker approvals
// ---------------------------------------------------------------------------------------------

enum ApprovalStatus {
  pending
  approved
  rejected

  @@map("approval_status")
}

/// A high-value action (refund, stock adjustment) waiting for a second, different staff member.
/// The database refuses decider = requester, edits to a decided request and deletes.
model ApprovalRequest {
  id           String         @id @default(uuid(7)) @db.Uuid
  kind         String
  subjectType  String         @map("subject_type")
  subjectId    String         @map("subject_id")
  amountMinor  BigInt         @map("amount_minor")
  currency     String         @db.Char(3)
  status       ApprovalStatus @default(pending)
  requestedBy  String         @map("requested_by") @db.Uuid
  decidedBy    String?        @map("decided_by") @db.Uuid
  reason       String?
  decisionNote String?        @map("decision_note")
  requestedAt  DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(6)
  consumedAt   DateTime?      @map("consumed_at") @db.Timestamptz(6)

  @@index([status, requestedAt])
  @@map("approval_requests")
}
