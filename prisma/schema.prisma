  cogsMinor            BigInt   @default(0) @map("cogs_minor")
  shippingChargedMinor BigInt   @default(0) @map("shipping_charged_minor")
  shippingCostMinor    BigInt   @default(0) @map("shipping_cost_minor")
  gatewayFeesMinor     BigInt   @default(0) @map("gateway_fees_minor")
  codFeesMinor         BigInt   @default(0) @map("cod_fees_minor")
  packagingMinor       BigInt   @default(0) @map("packaging_minor")
  returnsCostMinor     BigInt   @default(0) @map("returns_cost_minor")
  marketingMinor       BigInt   @default(0) @map("marketing_minor")
  opexMinor            BigInt   @default(0) @map("opex_minor")
  grossProfitMinor     BigInt   @default(0) @map("gross_profit_minor")
  netProfitMinor       BigInt   @default(0) @map("net_profit_minor")
  recomputedAt         DateTime @default(now()) @map("recomputed_at") @db.Timestamptz(6)

  @@map("daily_financial_summaries")
}

