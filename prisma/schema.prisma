  isActive    Boolean                 @default(true) @map("is_active")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expenses Expense[]

  @@index([isActive])
  @@map("recurring_expenses")
}

model Expense {
  id                 String    @id @default(uuid(7)) @db.Uuid
  expenseDate        DateTime  @map("expense_date") @db.Date
  categoryId         String    @map("category_id") @db.Uuid
  campaignId         String?   @map("campaign_id") @db.Uuid
  recurringExpenseId String?   @map("recurring_expense_id") @db.Uuid
  vendor             String
  description        String
  amountMinor        BigInt    @map("amount_minor")
  currency           String    @default("BDT") @db.Char(3)
  paymentMethod      String    @default("bank_transfer") @map("payment_method")
  reference          String?
  attachmentUrl      String?   @map("attachment_url")
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category         ExpenseCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  campaign         MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense?  @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  creator          StaffMember?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([expenseDate(sort: Desc)])
  @@index([categoryId, expenseDate])
  @@index([campaignId])
  @@map("expenses")
}

model DailyFinancialSummary {
