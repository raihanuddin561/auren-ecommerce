enum DiscountType {
  percentage
  fixed_amount
  free_shipping
  buy_x_get_y

  @@map("discount_type")
}

enum DiscountAppliesTo {
  order
  products
  collections
  categories

  @@map("discount_applies_to")
}

enum DiscountCustomerEligibility {
  all
  new
  segment

  @@map("discount_customer_eligibility")
}

model Discount {
  id                    String                      @id @default(uuid(7)) @db.Uuid
  code                  String?                     @unique @db.Citext
  title                 String
  type                  DiscountType
  value                 Decimal                     @db.Decimal(12, 2)
  appliesTo             DiscountAppliesTo           @default(order) @map("applies_to")
  targetIds             String[]                    @default([]) @map("target_ids") @db.Uuid
  minSubtotalMinor      BigInt?                     @map("min_subtotal_minor")
  minQuantity           Int?                        @map("min_quantity")
  maxDiscountMinor      BigInt?                     @map("max_discount_minor")
  customerEligibility   DiscountCustomerEligibility @default(all) @map("customer_eligibility")
  usageLimit            Int?                        @map("usage_limit")
  usageLimitPerCustomer Int?                        @map("usage_limit_per_customer")
  usageCount            Int                         @default(0) @map("usage_count")
  combinable            Boolean                     @default(false)
  startsAt              DateTime                    @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime?                   @map("ends_at") @db.Timestamptz(6)
  isActive              Boolean                     @default(true) @map("is_active")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions DiscountRedemption[]

  @@index([code])
  @@index([isActive, startsAt, endsAt])
  @@map("discounts")
}

model DiscountRedemption {
  id          String   @id @default(uuid(7)) @db.Uuid
  discountId  String   @map("discount_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  phone       String?
  amountMinor BigInt   @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([discountId])
  @@index([orderId])
  @@index([userId])
  @@index([phone])
  @@map("discount_redemptions")
}

