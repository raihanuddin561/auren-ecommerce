// AUREN physical data model. Logical model and rationale: docs/architecture/DATA-MODEL.md
//
// Conventions (see the auren-db-change skill):
//  - ids are UUIDv7 (time ordered), generated by Prisma: `@default(uuid(7)) @db.Uuid`
//  - tables are plural snake_case via @@map, columns snake_case via @map
//  - timestamps are timestamptz: created_at / updated_at
//  - money is BigInt minor units with a sibling `currency` column, never Decimal or Float
//  - ledger tables (outbox_events, audit_logs, stock_movements, ...) are append-only

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Key/value store settings (store info, currency, tax, policies, feature flags).
model StoreSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

/// Guards submits (checkout, payment) so a retried request returns the first response.
model IdempotencyKey {
  key         String   @id
  scope       String
  requestHash String?  @map("request_hash")
  response    Json?
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------------------------
// Identity (Better Auth). Model and field names follow what Better Auth's Prisma adapter expects;
// tables and columns are mapped to the AUREN snake_case convention.
// ---------------------------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid(7)) @db.Uuid
  name               String
  email              String   @unique @db.Citext
  emailVerified      Boolean  @default(false) @map("email_verified")
  image              String?
  phone              String?  @unique
  phoneVerified      Boolean  @default(false) @map("phone_verified")
  banned             Boolean  @default(false)
  /// Source of truth for staff two-factor enforcement (managed by the Better Auth plugin).
  twoFactorEnabled   Boolean  @default(false) @map("two_factor_enabled")
  /// Bootstrap password in use (first owner): staff must choose their own before anything else.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]
  staffMember StaffMember?
  cart        Cart?
  addresses   Address[]
  orders      Order[]
  storeCredit StoreCreditEntry[]
  discountRedemptions DiscountRedemption[]
  reviews     Review[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  /// Password hash (scrypt) for credential accounts.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// ---------------------------------------------------------------------------------------------
// Staff access control (ARCHITECTURE section 11)
// ---------------------------------------------------------------------------------------------

enum StaffRole {
  owner
  admin
  manager
  order_verifier
  fulfillment
  finance
  content_editor
  support

  @@map("staff_role")
}

model StaffMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  role      StaffRole
  active    Boolean   @default(true)
  invitedBy String?   @map("invited_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  confirmedOrders Order[]                    @relation("OrderConfirmedBy")
  assignedOrders  Order[]                    @relation("OrderAssignedTo")
  cancelledOrders Order[]                    @relation("OrderCancelledBy")
  createdOrders   Order[]                    @relation("OrderCreatedBy")
  attempts        OrderVerificationAttempt[]
  expenses        Expense[]
  moderatedReviews Review[]                  @relation("ReviewModerator")

  @@index([role])
  @@map("staff_members")
}

/// Which permissions each role holds. Seeded by migration; the application role can only read it (ADR-021).
model RolePermission {
  role       StaffRole
  permission String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([role, permission])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------------------------
// Transactional outbox and consumer inbox (ARCHITECTURE section 3.2, ADR-006)
// ---------------------------------------------------------------------------------------------

enum OutboxStatus {
  pending
  dispatched
  failed

  @@map("outbox_status")
}

/// Domain events written in the same transaction as the state change. Append-only: the
/// dispatcher may only touch status, attempts, availability, lease and error columns.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  /// Not dispatched before this time (retry backoff).
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  /// Lease held by a dispatcher while it sends the event.
  lockedUntil   DateTime?    @map("locked_until") @db.Timestamptz(6)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt  DateTime?    @map("dispatched_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

/// Which consumer already handled which event, so re-delivery has no second effect (INV-E2).
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
}

// ---------------------------------------------------------------------------------------------
// Audit trail: who changed what in the admin (append-only)
// ---------------------------------------------------------------------------------------------

/// Deliberately without a foreign key to users: the trail must outlive any account change.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// Catalog and stock foundations used by the development seed. Catalog and inventory modules extend
// these tables (collections, size charts, search vectors, reservations, ...).
// ---------------------------------------------------------------------------------------------

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

enum ProductFit {
  slim
  regular
  relaxed

  @@map("product_fit")
}

enum MediaType {
  image
  video

  @@map("media_type")
}

enum LocationType {
  warehouse
  store

  @@map("location_type")
}

enum StockMovementType {
  receipt
  sale
  reservation
  release
  return_restock
  adjustment
  transfer_in
  transfer_out
  write_off

  @@map("stock_movement_type")
}

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  slug           String
  name           String
  description    String?
  image          String?
  /// Required when an image is set (content standard).
  imageAlt       String?  @map("image_alt")
  position       Int      @default(0)
  /// Materialised path such as tops/shirts; unique across the tree.
  path           String   @unique
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  slug             String        @unique
  title            String
  subtitle         String?
  /// Markdown.
  description      String?
  status           ProductStatus @default(draft)
  categoryId       String?       @map("category_id") @db.Uuid
  productType      String?       @map("product_type")
  material         String?
  careInstructions String?       @map("care_instructions")
  fit              ProductFit?
  origin           String?
  sizeChartId      String?       @map("size_chart_id") @db.Uuid
  tags             String[]      @default([])
  /// Fabric, occasion, season, pattern.
  attributes       Json          @default("{}")
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description")
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  featuredRank     Int?          @map("featured_rank")
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sizeChart   SizeChart?          @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  options     ProductOption[]
  variants    ProductVariant[]
  media       ProductMedia[]
  collections CollectionProduct[]
  reviews          Review[]
  ratingStats      ProductRatingStats?
  lookbookHotspots LookbookHotspot[]
  featuredInArticles ArticleProduct[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@index([sizeChartId])
  @@map("products")
}

model ProductOption {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  /// Size, Color, Fit...
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id          String  @id @default(uuid(7)) @db.Uuid
  optionId    String  @map("option_id") @db.Uuid
  value       String
  label       String
  swatchHex   String? @map("swatch_hex")
  swatchImage String? @map("swatch_image")
  position    Int     @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]
  media    ProductMedia[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id             String        @id @default(uuid(7)) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  sku            String        @unique
  barcode        String?
  priceMinor     BigInt        @map("price_minor")
  compareAtMinor BigInt?       @map("compare_at_minor")
  /// Weighted average landed cost; snapshotted onto order lines.
  avgCostMinor   BigInt        @default(0) @map("avg_cost_minor")
  currency       String        @default("BDT") @db.Char(3)
  weightG        Int?          @map("weight_g")
  status         ProductStatus @default(active)
  position       Int           @default(0)
  isDefault      Boolean       @default(false) @map("is_default")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  inventory    InventoryLevel[]
  movements    StockMovement[]
  reservations StockReservation[]
  poItems      PurchaseOrderItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model ProductMedia {
  id            String    @id @default(uuid(7)) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  /// Ties an image to one colour.
  optionValueId String?   @map("option_value_id") @db.Uuid
  type          MediaType @default(image)
  /// static (file shipped with the app, development placeholders), local (development uploads) or vercel-blob.
  provider      String    @default("static")
  /// Random storage key from lib/media; null only for static files.
  storageKey    String?   @map("storage_key")
  url           String
  /// jpeg, png, webp or avif only (CHECK); never SVG.
  contentType   String?   @map("content_type")
  sizeBytes     Int?      @map("size_bytes")
  /// Required: descriptive alt text is part of the content standard.
  alt           String
  width         Int?
  height        Int?
  dominantColor String?   @map("dominant_color")
  blurData      String?   @map("blur_data")
  position      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_media")
}

/// Measurement table shared by many products. `table` is { columns: string[], rows: [{ size, values: string[] }] }.
model SizeChart {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  /// cm or in (CHECK).
  unit         String   @default("cm")
  table        Json     @default("{}")
  /// Markdown.
  howToMeasure String?  @map("how_to_measure")
  modelInfo    String?  @map("model_info")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("size_charts")
}

model Collection {
  id             String    @id @default(uuid(7)) @db.Uuid
  slug           String    @unique
  title          String
  description    String?
  /// { url, alt, provider, storageKey, contentType, sizeBytes } from the MediaProvider; alt is required.
  heroMedia      Json?     @map("hero_media")
  /// manual or automatic (CHECK).
  type           String    @default("manual")
  /// Automatic collections: { match: all|any, conditions: [{ field, operator, value }] }.
  rules          Json      @default("{}")
  /// manual, best_selling, newest, price_asc, price_desc (CHECK).
  sortOrder      String    @default("manual") @map("sort_order")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  /// Null = draft. A future date schedules the publication.
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  isFeatured     Boolean   @default(false) @map("is_featured")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  products CollectionProduct[]

  @@index([publishedAt])
  @@map("collections")
}

/// Manual members, or the materialised result of an automatic collection's rules.
model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
  @@map("collection_products")
}

/// Created automatically when the slug of a published product, category or collection changes.
model Redirect {
  id         String   @id @default(uuid(7)) @db.Uuid
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  /// 301 or 302 (CHECK).
  statusCode Int      @default(301) @map("status_code")
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([toPath])
  @@map("redirects")
}

model Location {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  type      LocationType @default(warehouse)
  address   Json?
  isDefault Boolean      @default(false) @map("is_default")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventory    InventoryLevel[]
  movements    StockMovement[]
  reservations StockReservation[]
  receipts     GoodsReceipt[]

  @@map("locations")
}

/// available = on_hand - reserved. Only the inventory service writes here once it exists.
model InventoryLevel {
  variantId         String   @map("variant_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([variantId, locationId])
  @@index([locationId])
  @@map("inventory_levels")
}

/// Append-only ledger of every stock change; the sum per variant and location equals on_hand.
model StockMovement {
  id            String            @id @default(uuid(7)) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  type          StockMovementType
  /// Signed: receipts are positive, sales negative.
  quantity      Int
  unitCostMinor BigInt?           @map("unit_cost_minor")
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  reason        String?
  actorId       String?           @map("actor_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt(sort: Desc)])
  @@index([locationId])
  @@map("stock_movements")
}

enum ReservationStatus {
  active
  committed
  released

  @@map("reservation_status")
}

/// Stock held for a checkout or order until it is committed or released (or expires: active only).
model StockReservation {
  id            String            @id @default(uuid(7)) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  /// Always > 0 (CHECK).
  quantity      Int
  /// checkout, order ... together with referenceId it makes reserve idempotent per variant.
  referenceType String            @map("reference_type")
  referenceId   String            @map("reference_id")
  status        ReservationStatus @default(active)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([referenceType, referenceId, variantId])
  @@index([variantId])
  @@index([locationId])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------------------------

enum PurchaseOrderStatus {
  draft
  ordered
  partially_received
  received
  cancelled

  @@map("purchase_order_status")
}

enum LandedCostType {
  freight
  customs_duty
  inbound_transport
  agent_fee
  other

  @@map("landed_cost_type")
}

enum AllocationMethod {
  by_quantity
  by_value

  @@map("allocation_method")
}

model Supplier {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  contactName  String?  @map("contact_name")
  phone        String?
  email        String?
  address      String?
  paymentTerms String?  @map("payment_terms")
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(uuid(7)) @db.Uuid
  /// PO-0001 style, from a database sequence.
  poNumber   String              @unique @default(dbgenerated("('PO-'::text || lpad((nextval('purchase_order_number_seq'::regclass))::text, 4, '0'::text))")) @map("po_number")
  supplierId String              @map("supplier_id") @db.Uuid
  status     PurchaseOrderStatus @default(draft)
  currency   String              @default("BDT") @db.Char(3)
  orderedAt  DateTime?           @map("ordered_at") @db.Timestamptz(6)
  expectedAt DateTime?           @map("expected_at") @db.Timestamptz(6)
  notes      String?
  createdBy  String?             @map("created_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  landedCosts LandedCost[]
  receipts    GoodsReceipt[]

  @@index([supplierId])
  @@index([status, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String @id @default(uuid(7)) @db.Uuid
  poId             String @map("po_id") @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  quantityOrdered  Int    @map("quantity_ordered")
  quantityReceived Int    @default(0) @map("quantity_received")
  unitCostMinor    BigInt @map("unit_cost_minor")

  purchaseOrder PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]

  @@unique([poId, variantId])
  @@index([variantId])
  @@map("purchase_order_items")
}

model LandedCost {
  id               String           @id @default(uuid(7)) @db.Uuid
  poId             String           @map("po_id") @db.Uuid
  type             LandedCostType
  amountMinor      BigInt           @map("amount_minor")
  allocationMethod AllocationMethod @default(by_quantity) @map("allocation_method")
  note             String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@map("landed_costs")
}

/// One delivery against a purchase order. Append-only together with its lines.
model GoodsReceipt {
  id         String   @id @default(uuid(7)) @db.Uuid
  poId       String   @map("po_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  receivedBy String?  @map("received_by") @db.Uuid
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Restrict)
  location      Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([poId])
  @@index([locationId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String @id @default(uuid(7)) @db.Uuid
  receiptId       String @map("receipt_id") @db.Uuid
  poItemId        String @map("po_item_id") @db.Uuid
  quantity        Int
  /// Supplier unit price at receipt.
  unitCostMinor   BigInt @map("unit_cost_minor")
  /// Landed costs allocated to this delivery (total for the line, not per unit).
  landedCostMinor BigInt @default(0) @map("landed_cost_minor")

  receipt GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  poItem  PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([poItemId])
  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------------------------------
// Insider-risk controls: maker-checker approvals
// ---------------------------------------------------------------------------------------------

enum ApprovalStatus {
  pending
  approved
  rejected

  @@map("approval_status")
}

/// A high-value action (refund, stock adjustment) waiting for a second, different staff member.
/// The database refuses decider = requester, edits to a decided request and deletes.
model ApprovalRequest {
  id           String         @id @default(uuid(7)) @db.Uuid
  kind         String
  subjectType  String         @map("subject_type")
  subjectId    String         @map("subject_id")
  amountMinor  BigInt         @map("amount_minor")
  currency     String         @db.Char(3)
  status       ApprovalStatus @default(pending)
  requestedBy  String         @map("requested_by") @db.Uuid
  decidedBy    String?        @map("decided_by") @db.Uuid
  reason       String?
  decisionNote String?        @map("decision_note")
  requestedAt  DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(6)
  consumedAt   DateTime?      @map("consumed_at") @db.Timestamptz(6)

  @@index([status, requestedAt])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------------------------
// Cart, delivery areas, shipping
// ---------------------------------------------------------------------------------------------

/// A visitor's bag. A guest cart is found by the hash of an opaque HttpOnly cookie, a signed-in
/// customer's by user id (one each); a guest bag is merged into the customer's on sign-in.
model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash String?  @unique @map("token_hash")
  userId    String?  @unique @map("user_id") @db.Uuid
  currency     String   @default("BDT") @db.Char(3)
  discountCode String?  @map("discount_code") @db.Citext
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  /// 1 to the per-line cap (CHECK). Prices are never stored here: they are read live.
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

enum GeoLevel {
  division
  district
  thana
  area

  @@map("geo_level")
}

/// Bangladesh address hierarchy: division, district, thana or upazila (and later area).
model GeoArea {
  id           String   @id @default(uuid(7)) @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  level        GeoLevel
  /// Stable slug path (`dhaka`, `dhaka/mirpur`) that seeds and settings use instead of ids.
  code         String   @unique
  name         String
  nameBn       String?  @map("name_bn")
  /// Courier area codes per courier, filled in when couriers are connected.
  courierCodes Json?    @map("courier_codes")
  position     Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent   GeoArea?  @relation("GeoTree", fields: [parentId], references: [id], onDelete: Restrict)
  children GeoArea[] @relation("GeoTree")

  @@index([parentId, level])
  @@map("geo_areas")
}

/// A customer's saved delivery address (accounts build on it; checkout stores a snapshot on the order).
model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String?
  fullName   String   @map("full_name")
  phone      String
  divisionId String   @map("division_id") @db.Uuid
  districtId String   @map("district_id") @db.Uuid
  /// A listed thana or upazila, or null when the customer typed one (see `thanaName`).
  thanaId    String?  @map("thana_id") @db.Uuid
  /// Display name of the thana or upazila, listed or typed (the free-text fallback).
  thanaName  String?  @map("thana_name")
  area       String?
  line1      String
  line2      String?
  postalCode String?  @map("postal_code")
  country    String   @default("BD") @db.Char(2)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// Where a set of rates applies. A zone lists geo areas of any level; the deepest match wins and
/// the single fallback zone catches everything else.
model ShippingZone {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  geoAreaIds String[] @default([]) @map("geo_area_ids") @db.Uuid
  isFallback Boolean  @default(false) @map("is_fallback")
  position   Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates ShippingRate[]

  @@map("shipping_zones")
}

model ShippingRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  zoneId        String   @map("zone_id") @db.Uuid
  name          String
  rateMinor     BigInt   @map("rate_minor")
  currency      String   @default("BDT") @db.Char(3)
  /// Delivery is free when the subtotal reaches this; null means never free.
  freeOverMinor BigInt?  @map("free_over_minor")
  minDays       Int      @map("min_days")
  maxDays       Int      @map("max_days")
  codAllowed    Boolean  @default(true) @map("cod_allowed")
  isActive      Boolean  @default(true) @map("is_active")
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([zoneId])
  @@map("shipping_rates")
}

// ---------------------------------------------------------------------------------------------
// Orders and payments
// ---------------------------------------------------------------------------------------------

enum OrderStatus {
  pending_payment
  payment_expired
  placed
  under_verification
  on_hold
  confirmed
  processing
  shipped
  delivered
  delivery_failed
  returned_to_origin
  completed
  return_requested
  returned
  refunded
  exchanged
  cancelled

  @@map("order_status")
}

enum OrderPaymentStatus {
  unpaid
  pending
  paid
  partially_refunded
  refunded
  failed

  @@map("order_payment_status")
}

enum OrderFulfillmentStatus {
  unfulfilled
  partially_fulfilled
  fulfilled
  returned

  @@map("order_fulfillment_status")
}

enum OrderChannel {
  web
  manual
  facebook
  instagram
  whatsapp
  store

  @@map("order_channel")
}

enum PaymentRecordStatus {
  initiated
  pending
  succeeded
  failed
  cancelled

  @@map("payment_record_status")
}

enum RiskFlagType {
  fake_order
  repeat_rto
  abusive
  manual

  @@map("risk_flag_type")
}

/// An order. It is born `placed` and only a staff member with `orders.verify` can confirm it: the
/// database refuses any status from `confirmed` onward without `confirmed_by` and `confirmed_at`
/// (INV-O9). The system never cancels an order (INV-O2).
model Order {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  /// AUR-100001, from a sequence.
  orderNumber          String                 @unique @default(dbgenerated("('AUR-'::text || nextval('order_number_seq'::regclass))")) @map("order_number")
  userId               String?                @map("user_id") @db.Uuid
  email                String?
  phone                String
  customerName         String                 @map("customer_name")
  status               OrderStatus            @default(placed)
  paymentStatus        OrderPaymentStatus     @default(unpaid) @map("payment_status")
  fulfillmentStatus    OrderFulfillmentStatus @default(unfulfilled) @map("fulfillment_status")
  channel              OrderChannel           @default(web)
  currency             String                 @db.Char(3)
  subtotalMinor        BigInt                 @map("subtotal_minor")
  discountMinor        BigInt                 @default(0) @map("discount_minor")
  shippingChargedMinor BigInt                 @map("shipping_charged_minor")
  /// VAT portion contained in the prices (prices are tax inclusive); informational.
  taxMinor             BigInt                 @default(0) @map("tax_minor")
  totalMinor           BigInt                 @map("total_minor")
  paidMinor            BigInt                 @default(0) @map("paid_minor")
  refundedMinor        BigInt                 @default(0) @map("refunded_minor")
  /// Snapshot: names, ids, area, line1, line2, postal code.
  shippingAddress      Json                   @map("shipping_address")
  billingAddress       Json?                  @map("billing_address")
  /// Snapshot of the delivery method (zone, rate name, estimate days, free-over rule applied).
  shippingMethod       Json                   @map("shipping_method")
  discountCodes        String[]               @default([]) @map("discount_codes")
  customerNote         String?                @map("customer_note")
  riskScore            Int                    @default(0) @map("risk_score")
  riskFlags            String[]               @default([]) @map("risk_flags")
  utm                  Json?
  /// SHA-256 of the guest tracking token (INV-O10); the token is derived, never stored.
  trackingTokenHash    String                 @unique @map("tracking_token_hash")
  /// Keyed hashes used for velocity limits (INV-O11).
  addressHash          String                 @map("address_hash")
  ipHash               String?                @map("ip_hash")
  placedAt             DateTime               @default(now()) @map("placed_at") @db.Timestamptz(6)
  assignedTo           String?                @map("assigned_to") @db.Uuid
  assignedAt           DateTime?              @map("assigned_at") @db.Timestamptz(6)
  /// The claim lock on the verification queue: others cannot act until this time passes.
  claimExpiresAt       DateTime?              @map("claim_expires_at") @db.Timestamptz(6)
  /// Raised after too many failed contact attempts; it never cancels anything (INV-O2).
  needsManagerReview   Boolean                @default(false) @map("needs_manager_review")
  escalatedAt          DateTime?              @map("escalated_at") @db.Timestamptz(6)
  /// The staff member who typed a manual order in (phone, Facebook, WhatsApp ...).
  createdBy            String?                @map("created_by") @db.Uuid
  verificationAttempts Int                    @default(0) @map("verification_attempts")
  nextAttemptAt        DateTime?              @map("next_attempt_at") @db.Timestamptz(6)
  confirmedBy          String?                @map("confirmed_by") @db.Uuid
  confirmedAt          DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  shippedAt            DateTime?              @map("shipped_at") @db.Timestamptz(6)
  deliveredAt          DateTime?              @map("delivered_at") @db.Timestamptz(6)
  returnedToOriginAt   DateTime?              @map("returned_to_origin_at") @db.Timestamptz(6)
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy          String?                @map("cancelled_by") @db.Uuid
  cancelReason         String?                @map("cancel_reason")
  cancelNote           String?                @map("cancel_note")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  verifier  StaffMember?               @relation("OrderConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict)
  assignee  StaffMember?               @relation("OrderAssignedTo", fields: [assignedTo], references: [id], onDelete: Restrict)
  canceller StaffMember?               @relation("OrderCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  creator   StaffMember?               @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items     OrderItem[]
  events    OrderEvent[]
  payments  Payment[]
  attempts  OrderVerificationAttempt[]
  costLines OrderCostLine[]
  refunds   Refund[]
  shipments   Shipment[]
  returns     ReturnRequest[]
  redemptions DiscountRedemption[]

  @@index([status, placedAt])
  @@index([placedAt(sort: Desc)])
  @@index([phone, status])
  @@index([addressHash, status])
  @@index([ipHash, placedAt])
  @@index([userId])
  @@index([assignedTo, status])
  @@index([deliveredAt])
  @@index([nextAttemptAt])
  @@map("orders")
}

/// One line of an order with a snapshot of what was sold: title, SKU, options, unit price and unit
/// cost (INV-O5). Later catalog edits never change it.
model OrderItem {
  id                   String   @id @default(uuid(7)) @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  variantId            String   @map("variant_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  titleSnapshot        String   @map("title_snapshot")
  variantTitleSnapshot String   @map("variant_title_snapshot")
  skuSnapshot          String   @map("sku_snapshot")
  /// [{ "name": "Size", "value": "M" }, ...]
  optionsSnapshot      Json     @map("options_snapshot")
  imageSnapshot        String?  @map("image_snapshot")
  unitPriceMinor       BigInt   @map("unit_price_minor")
  compareAtMinor       BigInt?  @map("compare_at_minor")
  /// Cost of goods at the time of sale (weighted average landed cost): the COGS snapshot.
  unitCostMinor        BigInt   @map("unit_cost_minor")
  quantity             Int
  discountMinor        BigInt   @default(0) @map("discount_minor")
  taxMinor             BigInt   @default(0) @map("tax_minor")
  totalMinor           BigInt   @map("total_minor")
  quantityReturned     Int      @default(0) @map("quantity_returned")
  /// Set on a replacement line created by an exchange: it points at the line that came back.
  replacementOfItemId  String?  @map("replacement_of_item_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems   ReturnItem[]   @relation("ReturnedItem")
  replacementOf OrderItem?     @relation("Replacement", fields: [replacementOfItemId], references: [id], onDelete: Restrict)
  replacements  OrderItem[]    @relation("Replacement")
  reviews       Review[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// The order timeline. Append-only.
model OrderEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  type       String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  payload    Json     @default("{}")
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Payment {
  id                String              @id @default(uuid(7)) @db.Uuid
  orderId           String              @map("order_id") @db.Uuid
  /// cod, sslcommerz, stripe, bkash
  provider          String
  /// cash, card, bkash, nagad ...
  method            String
  amountMinor       BigInt              @map("amount_minor")
  feeMinor          BigInt              @default(0) @map("fee_minor")
  currency          String              @db.Char(3)
  status            PaymentRecordStatus @default(initiated)
  providerRef       String?             @map("provider_ref")
  providerSessionId String?             @map("provider_session_id")
  idempotencyKey    String?             @unique @map("idempotency_key")
  raw               Json?
  paidAt            DateTime?           @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

/// Phones that cannot order online (fake orders, repeat returns to origin, abuse). Checked at
/// checkout and shown to the verification team.
model CustomerRiskFlag {
  id        String       @id @default(uuid(7)) @db.Uuid
  phone     String
  userId    String?      @map("user_id") @db.Uuid
  type      RiskFlagType
  note      String?
  createdBy String?      @map("created_by") @db.Uuid
  expiresAt DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone])
  @@map("customer_risk_flags")
}

/// One row per message the system tried to send. The recipient is stored masked. Append-only.
model NotificationLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  channel     String
  template    String
  toMasked    String   @map("to_masked")
  status      String
  providerRef String?  @map("provider_ref")
  error       String?
  relatedType String?  @map("related_type")
  relatedId   String?  @map("related_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([relatedType, relatedId])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------------------------
// Verification, fulfilment, refunds, returns, order costs
// ---------------------------------------------------------------------------------------------

enum VerificationChannel {
  call
  sms
  whatsapp
  messenger

  @@map("verification_channel")
}

enum VerificationOutcome {
  verified
  no_answer
  busy
  wrong_number
  callback_requested
  customer_cancelled
  suspected_fake
  order_edited

  @@map("verification_outcome")
}

/// One row per contact attempt or verification decision on an order. Append-only: it drives the
/// verification queue, the attempt counter and staff performance numbers.
model OrderVerificationAttempt {
  id            String              @id @default(uuid(7)) @db.Uuid
  orderId       String              @map("order_id") @db.Uuid
  staffId       String              @map("staff_id") @db.Uuid
  channel       VerificationChannel @default(call)
  outcome       VerificationOutcome
  /// The checklist as it stood when the attempt was saved: { genuine, items, address, payment, stock }.
  checklist     Json                @default("{}")
  note          String?
  nextAttemptAt DateTime?           @map("next_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([staffId, createdAt])
  @@map("order_verification_attempts")
}

enum OrderCostType {
  shipping
  gateway_fee
  cod_fee
  packaging
  return_shipping
  rto_loss
  other

  @@map("order_cost_type")
}

/// Every cost that belongs to one order and is not the cost of goods (that is the line snapshot).
/// Append-only: a mistake is corrected with a reversing (negative) line of the same type. Automatic lines carry
/// their source so recording the same cost twice changes nothing.
model OrderCostLine {
  id          String        @id @default(uuid(7)) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  type        OrderCostType
  amountMinor BigInt        @map("amount_minor")
  currency    String        @db.Char(3)
  sourceType  String?       @map("source_type")
  sourceId    String?       @map("source_id")
  note        String?
  actorId     String?       @map("actor_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_cost_lines")
}

enum RefundMethod {
  original
  store_credit
  manual_bkash

  @@map("refund_method")
}

enum RefundStatus {
  requested
  succeeded
  failed
  cancelled

  @@map("refund_status")
}

/// Money going back to a customer. A cancelled paid order creates a `requested` row that staff
/// process through the normal controls; nothing is refunded automatically.
model Refund {
  id              String       @id @default(uuid(7)) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  returnRequestId String?      @map("return_request_id") @db.Uuid
  amountMinor     BigInt       @map("amount_minor")
  currency        String       @db.Char(3)
  reason          String
  method          RefundMethod @default(manual_bkash)
  status          RefundStatus @default(requested)
  providerRef     String?      @map("provider_ref")
  note            String?
  requestedBy     String?      @map("requested_by") @db.Uuid
  actorId         String?      @map("actor_id") @db.Uuid
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(6)
  idempotencyKey  String?      @unique @map("idempotency_key")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

enum CourierId {
  pathao
  steadfast
  manual

  @@map("courier_id")
}

enum ShipmentStatus {
  pending
  booked
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  returned

  @@map("shipment_status")
}

enum ShipmentKind {
  outbound
  replacement

  @@map("shipment_kind")
}

model Shipment {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  kind           ShipmentKind   @default(outbound)
  courier        CourierId
  /// Free text for the manual courier ("Sundarban", "Own rider").
  courierName    String?        @map("courier_name")
  trackingNumber String?        @map("tracking_number")
  consignmentId  String?        @map("consignment_id")
  status         ShipmentStatus @default(pending)
  codAmountMinor BigInt         @default(0) @map("cod_amount_minor")
  /// What the courier charges us for carrying this parcel.
  costMinor      BigInt         @default(0) @map("cost_minor")
  codFeeMinor    BigInt         @default(0) @map("cod_fee_minor")
  currency       String         @db.Char(3)
  weightG        Int?           @map("weight_g")
  labelUrl       String?        @map("label_url")
  bookedBy       String?        @map("booked_by") @db.Uuid
  bookedAt       DateTime?      @map("booked_at") @db.Timestamptz(6)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events ShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([courier, trackingNumber])
  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  shipmentId  String         @map("shipment_id") @db.Uuid
  status      ShipmentStatus
  description String?
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// The courier's own id for this update, so a polled update is stored once.
  externalId  String?        @map("external_id")
  actorId     String?        @map("actor_id") @db.Uuid
  raw         Json?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, externalId])
  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

/// The box, tissue and card that go with an order. The default profile's cost is added to the order
/// when it is handed to the courier.
model PackagingProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  costMinor BigInt   @map("cost_minor")
  currency  String   @db.Char(3)
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("packaging_profiles")
}

enum ReturnType {
  return
  exchange

  @@map("return_type")
}

enum ReturnStatus {
  requested
  approved
  rejected
  in_transit
  received
  inspected
  refunded
  exchanged
  closed

  @@map("return_status")
}

enum ReturnResolution {
  refund
  store_credit
  exchange

  @@map("return_resolution")
}

enum ReturnReason {
  too_small
  too_large
  defective
  not_as_described
  changed_mind

  @@map("return_reason")
}

enum ReturnCondition {
  resellable
  damaged

  @@map("return_condition")
}

model ReturnRequest {
  id                      String            @id @default(uuid(7)) @db.Uuid
  /// RET-0001, from a sequence.
  returnNumber            String            @unique @default(dbgenerated("('RET-'::text || lpad((nextval('return_number_seq'::regclass))::text, 4, '0'::text))")) @map("return_number")
  orderId                 String            @map("order_id") @db.Uuid
  type                    ReturnType        @default(return)
  status                  ReturnStatus      @default(requested)
  customerNote            String?           @map("customer_note")
  staffNote               String?           @map("staff_note")
  resolution              ReturnResolution?
  returnShippingCostMinor BigInt            @default(0) @map("return_shipping_cost_minor")
  currency                String            @db.Char(3)
  requestedBy             String?           @map("requested_by")
  decidedBy               String?           @map("decided_by") @db.Uuid
  decidedAt               DateTime?         @map("decided_at") @db.Timestamptz(6)
  receivedAt              DateTime?         @map("received_at") @db.Timestamptz(6)
  inspectedAt             DateTime?         @map("inspected_at") @db.Timestamptz(6)
  closedAt                DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id                String           @id @default(uuid(7)) @db.Uuid
  returnId          String           @map("return_id") @db.Uuid
  orderItemId       String           @map("order_item_id") @db.Uuid
  quantity          Int
  reason            ReturnReason
  /// Filled in at inspection.
  condition         ReturnCondition?
  /// The variant the customer wants instead (an exchange for another size).
  exchangeVariantId String?          @map("exchange_variant_id") @db.Uuid

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderItem     OrderItem     @relation("ReturnedItem", fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

enum StoreCreditReason {
  return
  goodwill
  redeem

  @@map("store_credit_reason")
}

/// Store credit as a ledger: the balance is the sum. Append-only.
model StoreCreditEntry {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  /// Signed: positive adds credit, negative spends it.
  amountMinor BigInt            @map("amount_minor")
  currency    String            @db.Char(3)
  reason      StoreCreditReason
  referenceId String?           @map("reference_id")
  actorId     String?           @map("actor_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("store_credit_ledger")
}

