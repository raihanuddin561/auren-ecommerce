  rent
  utilities
  software
  photography
  packaging_stock
  logistics
  professional_fees
  bank_charges
  misc

  @@map("expense_category_type")
}

enum MarketingCampaignChannel {
  meta
  google
  tiktok
  influencer
  email
  offline

  @@map("marketing_campaign_channel")
}

enum RecurringExpenseCadence {
