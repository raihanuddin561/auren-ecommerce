{
  "name": "auren-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "typecheck": "cross-env SKIP_ENV_VALIDATION=1 next typegen && tsc --noEmit",
    "prepare": "husky || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait postgres mailpit",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:roles": "tsx scripts/db-roles.ts",
    "db:generate": "prisma generate",
    "setup:local": "pnpm db:migrate:deploy && pnpm db:seed",
    "db:seed": "tsx --import ./scripts/stub-server-only.mjs prisma/seed.ts",
    "db:seed:reference": "tsx --import ./scripts/stub-server-only.mjs scripts/seed-reference.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:coverage": "vitest run --coverage",
    "owner:create": "tsx --import ./scripts/stub-server-only.mjs scripts/create-owner.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:visual": "cross-env E2E_VISUAL=1 NODE_OPTIONS=--import=./scripts/stub-server-only.mjs playwright test style-guide.visual",
    "test:e2e:run": "cross-env NODE_OPTIONS=--import=./scripts/stub-server-only.mjs playwright test",
    "seed:images": "tsx scripts/generate-seed-images.ts",
    "secrets:scan": "node scripts/secret-scan.mjs --all",
    "secrets:history": "node scripts/secret-scan.mjs --history",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^11.1.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "inngest": "^4.21.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "type": "module"
}
