# AUREN environment. Copy to `.env` for local development: `cp .env.example .env`
# Variables marked REQUIRED make `next dev` and `next build` fail when missing.
# Everything else is optional and falls back to a local no-op or in-memory behaviour.

# --- Core ---------------------------------------------------------------------------------
# PRODUCTION BOOT GUARDS: with NODE_ENV=production the app refuses to start unless APP_URL is an
# explicit https URL, BETTER_AUTH_SECRET is strong, Upstash + both Inngest keys are set, an email
# provider is configured and TRUSTED_PROXY is not none (unset is fine on Vercel). A production
# build served from localhost (browser tests, local smoke runs) must set LOCAL_PRODUCTION=1 and an
# explicit APP_URL=http://localhost:<port>; Vercel ignores that opt-out.
# Public base URL of the app (used for auth callbacks, emails, canonical URLs).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
# Max connections in the pg pool per server instance (keep low on serverless).
DB_POOL_MAX=10

# REQUIRED. The RUNTIME connection: the least-privilege role auren_app (DML only, no DDL, cannot
# rewrite audit/stock/outbox ledgers). Created by the migrations without a login; the local setup
# script (scripts/local-db-setup.sql) gives it one. See docs/runbooks/local-database.md.
# Production (Supabase, ADR-025): the TRANSACTION POOLER, port 6543, with TLS and a small pool:
#   postgresql://auren_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# (the Prisma pg adapter uses no named prepared statements, so the pooler works; keep DB_POOL_MAX <= 10)
DATABASE_URL=postgresql://auren_app:CHANGE-ME-app@localhost:5432/auren
# The OWNER connection, used ONLY by migrations and seeds: auren_migrator. Locally the same server
# on 5432. Production: the Supabase direct connection or the session pooler (port 5432), also with
# sslmode=require, and it must differ from DATABASE_URL. Never use it at runtime.
DIRECT_URL=postgresql://auren_migrator:CHANGE-ME-migrator@localhost:5432/auren

# Which headers identify the client address for rate limits and the audit log:
#   vercel    trust x-vercel-forwarded-for / x-real-ip (default on Vercel)
#   forwarded trust x-forwarded-for from any proxy (default outside production)
#   none      ignore proxy headers (default for production hosts that are not Vercel;
#             set `forwarded` if you run behind your own reverse proxy)
TRUSTED_PROXY=

# REQUIRED. 32+ random characters. Generate with: openssl rand -base64 32
# The value below is a development placeholder only; production rejects placeholders, weak and
# low-entropy values.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# --- Auth ---------------------------------------------------------------------------------
# Secret rotation (optional, newest first): BETTER_AUTH_SECRETS=2:<new secret>,1:<previous secret>
# Procedure in docs/runbooks/key-rotation.md.
BETTER_AUTH_SECRETS=
# Google OAuth (set both or neither). Without them the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Name shown in authenticator apps for staff two-factor.
TOTP_ISSUER=AUREN

# Cloudflare Turnstile bot check on sign-in (optional; set both or neither). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile and paste its keys. Without them there is no
# bot check (the per-address and per-account limits still apply).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Orders ------------------------------------------------------------------------------
# Key for guest order tracking links (32+ characters). Blank: BETTER_AUTH_SECRET is used.
# Changing it breaks tracking links already sent to customers.
ORDER_TOKEN_SECRET=
# SMS transport for order codes. Only "log" exists (writes the code to the server log); a gateway
# is added when one is chosen. Phone codes at checkout are off until the owner turns them on.
SMS_PROVIDER=

# --- Email --------------------------------------------------------------------------------
# Production: Resend. Local: Mailpit SMTP from docker-compose (web UI on http://localhost:8025).
# With neither set, emails are written to the log.
RESEND_API_KEY=
EMAIL_FROM="AUREN <no-reply@auren.local>"
SMTP_URL=smtp://localhost:1025

# --- Rate limiting (Upstash Redis; set both or neither) ----------------------------------
# Without them an in-memory limiter is used (single instance only, fine for local and tests).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Background jobs (Inngest) ------------------------------------------------------------
# Local: run `pnpm dlx inngest-cli@latest dev` and set INNGEST_DEV=1. Cloud: set both keys.
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Previous signing key, kept only while rotating (docs/runbooks/key-rotation.md).
INNGEST_SIGNING_KEY_FALLBACK=

# Restrict the owner and finance roles to these networks (comma separated IPv4, IPv4 CIDR, IPv6).
# From anywhere else those accounts get a 404 like a customer. Leave empty for no restriction; a
# malformed value locks them out (fail closed).
PRIVILEGED_IP_ALLOWLIST=

# Bearer token for the detailed /api/health report (24+ random characters). Without it the public
# endpoint only answers {"status":"ok|degraded|down"}.
HEALTH_DETAIL_TOKEN=

# --- Observability (Sentry; all optional) -------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Used only in CI to upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Storefront ---------------------------------------------------------------------------
# Set to 1 to show the maintenance page (503) on storefront pages. The admin console and every
# /api route (webhooks, health) keep working. Orders are never changed by maintenance mode.
MAINTENANCE_MODE=
# WhatsApp number for the floating concierge button, international format (for example
# +8801700000000). Without it the button opens the contact page.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Test-only ---------------------------------------------------------------------------
# Playwright sets E2E_STAFF_BYPASS=1 to render admin screens without a database. The app refuses
# to start with it when APP_URL is not localhost or when running on Vercel. Never set it yourself.
# E2E_STAFF_BYPASS=

# --- Media (ADR-026) ----------------------------------------------------------------------
# Production: a Vercel Blob read-write token (REQUIRED there; the boot guard refuses to start
# without it). Development and tests: leave blank, files go to MEDIA_LOCAL_DIR on this machine.
BLOB_READ_WRITE_TOKEN=
# Local media folder (git-ignored). Default: .local-media
MEDIA_LOCAL_DIR=

# --- Local seed and tests -----------------------------------------------------------------
# Owner account created by `pnpm db:seed`. If the password is blank, a random one is generated
# and printed once.
SEED_OWNER_EMAIL=owner@auren.local
SEED_OWNER_PASSWORD=
# LOCAL DEMO ONLY. SEED_DEMO_ADMIN=1 makes `pnpm db:seed` create the owner without the forced first-login
# password change, so a throwaway password works. Honoured only outside production with a localhost
# APP_URL; the app refuses to boot with it set anywhere else, and production rejects both this and
# SEED_OWNER_PASSWORD. Two-factor stays mandatory.
# SEED_DEMO_ADMIN=1
# Integration tests: your local throwaway database (the name must contain "test"), as the owner role.
# Left blank, Testcontainers starts a PostgreSQL (needs Docker; CI uses a service container).
TEST_DATABASE_URL=postgresql://auren_migrator:CHANGE-ME-migrator@localhost:5432/auren_test
# Optional: the same database as auren_app; turns on the real-login role checks.
TEST_APP_DATABASE_URL=postgresql://auren_app:CHANGE-ME-app@localhost:5432/auren_test

# Tooling only: skips env validation (e.g. `prisma generate` in CI before secrets exist).
# SKIP_ENV_VALIDATION=1
